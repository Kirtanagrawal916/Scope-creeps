# Server
PORT=5000
NODE_ENV=development

# Frontend URL (used for CORS in Task 2, OAuth redirect later)
CLIENT_URL=http://localhost:5173

# MongoDB (reused from the existing TanStack Start app's DB, or a new one — confirm with team)
MONGODB_URI=

# JWT (if this backend issues its own tokens — confirm with auth owner)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gmail OAuth — added when Task "Gmail OAuth" starts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback

# Gemini API — added when Task "Gemini Integration" starts
GEMINI_API_KEY=
