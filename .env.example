# ==============================================================================
# ScopeGuard - Environment Configuration Template
# Copy this file to .env and fill in the values for local development.
# ==============================================================================

# Node Environment
# Options: development, production
NODE_ENV=development

# Database Connection URI (Required)
# Use a local MongoDB instance or a MongoDB Atlas connection string.
# Example: mongodb://localhost:27107/scopeguard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/scope-creeps?retryWrites=true&w=majority

# DNS Resolver Override (Optional)
# Set to "true" only if your network's default DNS resolver fails to resolve 
# MongoDB Atlas SRV records (e.g. some home ISPs).
# Set to "false" (recommended) if you are behind a corporate VPN or university 
# firewall that blocks public DNS port 53 outbound queries.
MONGODB_OVERRIDE_DNS=false

# Authentication Secret (Required)
# A secure, random secret key used to sign JWT session tokens.
# Do NOT share this key or commit it to Git.
JWT_SECRET=scopeguard-dev-secret-change-in-production

# Client Session Cookie Secret (Optional, legacy support)
SESSION_SECRET=super-secret-session-key-change-this-in-production

# Google OAuth Credentials (Optional - required only if testing Google login flow)
# Obtain these from the Google Cloud Console (https://console.cloud.google.com)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# CALLBACK_URL=http://localhost:3000/auth/callback
